generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tender {
  id              Int            @id @default(autoincrement())
  prozorroId      String         @unique
  title           String?
  description     String?
  procuringEntity String?
  cpvCodes        String[]
  valueAmount     Float?
  valueCurrency   String?
  status          String?
  datePublished   DateTime?
  dateModified    DateTime?
  documentLength  Int            @default(0)
  buyerEdrpou     String?        // procuringEntity.identifier.id
  buyerRegion     String?        // normalised oblast of the buyer
  cpvDivision     String?        // first two digits of items[0].classification.id (ДК021 division)
  rawData         Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenderIndexes   TenderIndex[]
  participations  Participation[]
  sample          TenderSample?

  @@index([buyerEdrpou])
  @@index([cpvDivision])
}

model TenderIndex {
  id            Int    @id @default(autoincrement())
  tenderId      Int
  term          String
  termFrequency Int
  fieldName     String
  tender        Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([term])
  @@index([tenderId])
  @@index([term, tenderId])
}

model TermStatistics {
  id                Int     @id @default(autoincrement())
  term              String  @unique
  documentFrequency Int
  idf               Float
  dfTitle           Int     @default(0)
  dfDescription     Int     @default(0)
  dfCpv             Int     @default(0)
  collectionFrequency Int   @default(0)
  updatedAt         DateTime @updatedAt
}

model CollectionStats {
  id                 Int      @id @default(autoincrement())
  totalDocuments     Int
  avgDocumentLength  Float
  uniqueTerms        Int
  avgTitleLength     Float?
  avgDescriptionLength Float?
  avgCpvCodesLength  Float?
  avgFieldLengths    Json?
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt
}

model TestQuery {
  id          Int                 @id @default(autoincrement())
  queryText   String
  category    String?
  difficulty  String?
  createdAt   DateTime            @default(now())
  judgments   RelevanceJudgment[]
}

model RelevanceJudgment {
  id             Int      @id @default(autoincrement())
  queryId        Int
  tenderId       Int
  relevanceScore Int
  comment        String?
  createdAt      DateTime @default(now())
  query          TestQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([tenderId])
}

model ExperimentResult {
  id               Int      @id @default(autoincrement())
  experimentName   String
  k1               Float
  b                Float
  fieldWeights     Json?
  usesLemmatization Boolean
  usesMultifield   Boolean
  precisionAt10    Float
  recallAt10       Float
  meanAvgPrecision Float
  numTestQueries   Int
  createdAt        DateTime @default(now())
}

// OSINT Analysis Models (OECD bid-rigging indicators)

model OsintReport {
  id            Int      @id @default(autoincrement())
  generatedAt   DateTime @default(now())
  numTenders    Int
  metadata      Json     // thresholds, versions, etc.

  // Summary stats
  singleBidderCount    Int
  singleBidderRatio    Float
  multiBidderCount     Int

  // Aggregated data (JSON for flexibility)
  topSingleBidderEntities Json  // [{edrpou, name, count}]
  coParticipationPairs    Json  // [{edrpouA, edrpouB, nameA, nameB, count, tenderIds}]
  winRateAnomalies        Json  // [{edrpou, name, bids, wins, rate}]
  regionalDominance       Json  // [{region, dominantEdrpou, dominantName, wins, total, pct}]
  hhiPerCpv               Json  // [{cpvDivision, totalAwards, uniqueSuppliers, hhi, level}]
  bidRotationCohorts      Json  // [{cohortEdrs, numTenders, winnersCount, uniformity}]

  @@index([generatedAt])
}

model SupplierOsintStats {
  id              Int      @id @default(autoincrement())
  edrpou          String   @unique
  name            String?

  // Win rate stats
  totalBids       Int      @default(0)
  totalWins       Int      @default(0)
  winRate         Float    @default(0)

  // Co-participation (top partners)
  topPartners     Json?    // [{edrpou, name, count}]

  // Regional stats
  regionsActive   String[] // regions where this supplier participates
  dominantRegion  String?  // region where they dominate (if any)

  updatedAt       DateTime @updatedAt

  @@index([winRate])
  @@index([totalWins])
}

model ProcuringEntityOsintStats {
  id                  Int      @id @default(autoincrement())
  edrpou              String   @unique
  name                String?
  region              String?

  // Single bidder stats
  totalTenders        Int      @default(0)
  singleBidderTenders Int      @default(0)
  singleBidderRatio   Float    @default(0)

  updatedAt           DateTime @updatedAt

  @@index([singleBidderRatio])
  @@index([singleBidderTenders])
}

// ---------------------------------------------------------------------------
// AMCU bid-rigging labels and graph-building tables (master thesis, Sept 2026)
// ---------------------------------------------------------------------------

/// One row per (decision, company, court event) from the AMCU consolidated
/// register "Зведені відомості про рішення органів Комітету ... спотворення
/// результатів торгів". Loaded by evaluation/load_amcu_labels.py.
model AmcuDecision {
  id              Int       @id @default(autoincrement())
  decisionNumber  String
  decisionDate    DateTime
  body            String?   // орган АМКУ, що прийняв рішення
  edrpou          String    // ЄДРПОУ (8) або ІПН ФОП (10)
  companyName     String?
  courtCaseNumber String?
  courtName       String?
  courtDate       DateTime?
  courtContent    String?   // зміст рішення суду (скасовано / відмовлено ...)
  reviewNumber    String?   // № рішення органу АМКУ за результатами перегляду
  reviewDate      DateTime?
  reviewContent   String?
  notes           String?
  registerVersion String    // дата файлу реєстру, напр. 2026-08-31
  createdAt       DateTime  @default(now())

  @@unique([registerVersion, decisionNumber, decisionDate, edrpou, courtName, courtDate], name: "amcu_row_key")
  @@index([edrpou])
  @@index([decisionDate])
}

/// Flat "who took part in which tender" table derived from Tender.rawData
/// (bids[].tenderers[], awards[].suppliers[]). Built by
/// evaluation/build_participations.py; source of graph edges.
model Participation {
  id               Int       @id @default(autoincrement())
  tenderId         Int
  tender           Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  prozorroTenderId String    // UA-YYYY-MM-DD-NNNNNN-x
  edrpou           String
  name             String?
  role             String    // bidder | winner
  lotId            String?
  bidAmount        Float?
  bidDate          DateTime?
  bidStatus        String?
  isWinner         Boolean   @default(false)
  datePublished    DateTime?
  region           String?   // область реєстрації учасника з картки в Prozorro

  @@index([edrpou])
  @@index([tenderId])
  @@index([prozorroTenderId])
  @@index([edrpou, datePublished])
  @@index([tenderId, role, edrpou])   // co-bidder / winner joins in the risk API
}

/// Membership of a tender in the thesis dataset: positive (has a sanctioned
/// participant) or unlabeled (stratified sample). Built by
/// evaluation/sample_unlabeled.py finalize.
model TenderSample {
  id                    Int      @id @default(autoincrement())
  tenderId              Int      @unique
  tender                Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  sampleGroup           String   // positive | unlabeled
  year                  Int
  procurementMethodType String?
  cpvDivision           String?
  bidsCount             Int      @default(0)
  hasSanctioned         Boolean  @default(false)
  sanctionedEdrpous     String[]
  sampleVersion         String
  createdAt             DateTime @default(now())

  @@index([sampleGroup])
  @@index([year, procurementMethodType])
}

/// Per-company bid-rigging risk score produced by evaluation/ml/score_companies.py
/// (GraphSAGE over the co-bidding graph, trained on AMCU seeds vs full-history controls).
model CompanyRisk {
  id             Int      @id @default(autoincrement())
  edrpou         String   @unique
  name           String?
  score          Float               // 0..1 probability-like risk
  rank           Int                 // 1 = highest risk
  percentile     Float               // 0..100, share of companies with lower score
  label          Boolean  @default(false)   // in AMCU register
  firstDecision  DateTime?
  group          String              // amcu | control | other
  coverage       String              // full | capped | partial
  nTenders       Int      @default(0)
  nWon           Int      @default(0)
  winRate        Float    @default(0)
  degree         Int      @default(0)
  region         String?             // найчастіша область реєстрації за картками учасника
  features       Json                // raw feature values used by the model
  contributions  Json                // [{feature, value, contribution}] from the linear explainer
  topNeighbors   Json                // [{edrpou, name, weight, score, label}]
  modelVersion   String
  computedAt     DateTime @default(now())

  @@index([score])
  @@index([rank])
  @@index([group, coverage])
  @@index([region])
}

/// Retrospective check ("what would the system have said on 31 December of the
/// cutoff year"): GraphSAGE trained on the graph snapshot up to the cutoff with
/// the AMCU decisions known by then, scores for every company in the snapshot,
/// and the outcome taken from the current register. Written by
/// evaluation/ml/backtest_snapshots.py.
model RiskBacktest {
  id            Int       @id @default(autoincrement())
  cutoffYear    Int                 // snapshot = tenders up to 31.12.cutoffYear (or cutoffDate)
  cutoffDate    DateTime?           // exact cutoff when it is not the end of the year (forward forecast)
  edrpou        String
  name          String?
  score         Float               // raw GraphSAGE probability at the cutoff
  rank          Int                 // 1 = highest risk among all companies in the snapshot
  rankFull      Int?                // rank among full-coverage companies only (fair population)
  group         String              // amcu | control | other
  coverage      String              // full | capped | partial
  nTenders      Int       @default(0)
  degree        Int       @default(0)
  knownAtCutoff Boolean   @default(false)   // first AMCU decision <= cutoff (used as training label)
  firstDecision DateTime?           // from the current register
  outcome       String              // known | caught | none  (caught = first decision after the cutoff)
  modelVersion  String
  computedAt    DateTime  @default(now())

  @@unique([cutoffYear, edrpou])
  @@index([cutoffYear, rank])
  @@index([cutoffYear, coverage, rankFull])
  @@index([cutoffYear, outcome])
}

/// Two companies that share a contact value in their Prozorro bidder cards
/// (phone / e-mail / contact person / street address). Loaded from
/// evaluation/mining/shared_contacts.py output by evaluation/load_links_groups.py.
model CompanyLink {
  id       Int    @id @default(autoincrement())
  edrpouA  String
  edrpouB  String
  kinds    String[]   // phone | email | person | address

  @@unique([edrpouA, edrpouB])
  @@index([edrpouA])
  @@index([edrpouB])
}

/// Tight co-bidding group: connected component of pairs with high exclusivity
/// and >= 3 shared tenders, size 2..15. Built by evaluation/load_links_groups.py.
model TightGroup {
  id             Int      @id
  size           Int
  sharedTenders  Int                 // distinct tenders where >= 2 members met
  totalTenders   Int                 // distinct tenders with any member bidding
  wonAmount      Float               // sum of winning bid amounts of members, UAH
  sanctioned     Int                 // members in the AMCU register
  sameDecision   Int                 // member pairs named in one AMCU decision
  meanScore      Float
  maxScore       Float
  regions        String[]
  topCpv         String[]            // CPV divisions where the group bids most
  firstShared    DateTime?
  lastShared     DateTime?
  computedAt     DateTime @default(now())
  members        TightGroupMember[]

  @@index([maxScore])
  @@index([wonAmount])
  @@index([sanctioned])
}

model TightGroupMember {
  id        Int        @id @default(autoincrement())
  groupId   Int
  group     TightGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  edrpou    String
  name      String?
  score     Float?
  label     Boolean    @default(false)
  nTenders  Int        @default(0)
  nWon      Int        @default(0)
  wonAmount Float      @default(0)

  @@unique([groupId, edrpou])
  @@index([edrpou])
}
