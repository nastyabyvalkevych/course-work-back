# add ?connect_timeout=5&pool_timeout=10 so a paused/unreachable database fails fast
DATABASE_URL=
PROZORRO_API_URL=
PORT=3002
LEMMATIZER_URL=
FRONTEND_URL=
REDIS_URL=

# P3.9: shared-secret API key required for mutating endpoints
# (POST /api/indexing/*, /api/prozorro/*, /api/experiments/{run,grid-search}).
# Generate with: `openssl rand -hex 32`
# When unset, those endpoints return 503 Service Unavailable.
INDEXING_API_KEY=
# soft cache: operations bounded by this timeout, failures degrade to no-cache (see redis.service.ts)
REDIS_TIMEOUT_MS=200
